{
  "id": "flm_lab",
  "title": "FLM Lab",
  "description": "Experimental: play the headlights' own welcome / goodbye animation, any light function or one LED channel, and simple light shows, parked only",
  "version": "0.1.1",
  "vendor": "custom",
  "loggingId": "OAB1",
  "iconGlyph": "LAB",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "FLM Lab",
      "buttons": [
        ["BTN_WELCOME", "Welcome"],
        ["BTN_SHOW", "Play show"],
        ["BTN_STOP", "Stop all"],
        ["BTN_PAGE", "Next page"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "functionSeconds", "label": "Light function hold", "type": "number", "unit": "s", "default": 10, "steps": [2, 5, 10, 20, 30, 60]},
    {"key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto",
     "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]}
  ]
}
